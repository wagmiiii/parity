# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv*/

# Environment files
.env
.env.local

# Project data artifacts and runs (rebuildable or large)
artifacts/*
!artifacts/.gitkeep
runs/*
!runs/.gitkeep
data/build/*
!data/build/.gitkeep

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Build artifacts
dist/
build/
*.egg-info/

# OS files
.DS_Store
Thumbs.db
